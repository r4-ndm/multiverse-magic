{
  "name": "multiverse-magic",
  "version": "1.0.0",
  "description": "Multiverse Magic — A Permissionless 3D Proximity Chat Universe",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "vite client --port 3000 --host",
