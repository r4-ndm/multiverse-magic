    "@colyseus/schema": "^2.0.36",
    "@colyseus/ws-transport": "^0.15.1",
    "colyseus": "^0.15.17",
    "colyseus.js": "^0.15.28",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "vite": "^8.3.0"
  }
